{
  "manifest_version": 3,
  "name": "WikiTagger",
  "version": "1.12.0",
  "description": "Classement des cartes WikiMasters par mots-clés et étiquettes.",
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://wiki-masters.com/*",
    "https://www.wiki-masters.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://wiki-masters.com/*",
        "https://www.wiki-masters.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WikiTagger",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
