// ==UserScript==
// @name         WikiTagger
// @namespace    https://github.com/HYZO-ai/WikiTagger
// @version      1.1.0
// @description  Tri et étiquetage automatique sur WikiMasters
// @author       HYZO
// @match        https://www.wiki-masters.com/*
// @icon         https://raw.githubusercontent.com/HYZO-ai/WikiTagger/main/icon128.png
// @icon64       https://raw.githubusercontent.com/HYZO-ai/WikiTagger/main/icon128.png
// @homepageURL  https://github.com/HYZO-ai/WikiTagger
// @updateURL    https://raw.githubusercontent.com/HYZO-ai/WikiTagger/main/WikiTagger_Tampermonkey.user.js
// @downloadURL  https://raw.githubusercontent.com/HYZO-ai/WikiTagger/main/WikiTagger_Tampermonkey.user.js
// ==/UserScript==


(function(){
'use strict';
if(window.__wikiTaggerTampermonkey) return;
window.__wikiTaggerTampermonkey=true;
const KEY='WikiTagger_Tampermonkey_data';
const fallback=()=>{try{return JSON.parse(localStorage.getItem(KEY)||'{}')}catch{return {}}};
const read=()=>{try{return GM_getValue('state',{})||{}}catch{return fallback()}};
const write=v=>{try{GM_setValue('state',v)}catch{localStorage.setItem(KEY,JSON.stringify(v))}};
let state=read();
const chrome={
 storage:{local:{async get(keys){const v=state;if(typeof keys==='string')return {[keys]:v[keys]};if(Array.isArray(keys))return Object.fromEntries(keys.map(k=>[k,v[k]]));if(keys&&typeof keys==='object')return {...keys,...v};return {...v}},async set(data){state={...state,...data};write(state)}}},
 runtime:{onMessage:{addListener(fn){chrome._contentListener=fn}},async sendMessage(m){
  if(m.type==='DIAG'){const row={timestamp:new Date().toISOString(),event:String(m.event||'unknown'),tabId:null,details:m.data||{}};state.diagnostics=[...(state.diagnostics||[]),row].slice(-2500);write(state)}
  if(m.type==='LOG'){state.logs=[{time:new Date().toLocaleTimeString('fr-FR'),text:m.text},...(state.logs||[])].slice(0,100);write(state)}
  if(m.type==='PROGRESS'){state.progress=m.progress;write(state)}
  if(m.type==='DONE'){state.running=false;state.paused=false;write(state);const message=m.error?'Traitement interrompu : '+m.error:'Toutes les cartes sont étiquetées.';try{GM_notification({title:'WikiTagger',text:message,timeout:7000})}catch{console.info('WikiTagger:',message)}}
  return {ok:true};
 }},
 tabs:{async query(){return [{id:1,url:location.href,status:document.readyState==='complete'?'complete':'loading'}]},async get(){return {id:1,url:location.href,status:document.readyState==='complete'?'complete':'loading'}},async update(id,details){if(details.url)location.assign(details.url)} ,async sendMessage(id,m){if(!chrome._contentListener)throw Error('Moteur WikiTagger non chargé');return new Promise((resolve,reject)=>{let done=false;const reply=r=>{if(!done){done=true;resolve(r)}};try{const async=chrome._contentListener(m,{},reply);if(!async&&!done)reply({ok:true});if(async)setTimeout(()=>{if(!done)reject(Error('Délai de réponse dépassé'))},60000)}catch(e){reject(e)}})}},
 scripting:{async executeScript(){return []}}
};
// Preserve the original extension's onMessage interface without exposing globals.

(()=>{
if(window.__wikiTaggerLoaded)return;window.__wikiTaggerLoaded=true;
let stopped=false,paused=false,working=false;
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
const log=t=>chrome.runtime.sendMessage({type:'LOG',text:t}).catch(()=>{});
const debug=(event,data={})=>chrome.runtime.sendMessage({type:'DIAG',event,data:{...data,url:location.origin+location.pathname,working,paused,stopped}}).catch(()=>{});
const buttonState=()=>buttons().map(b=>({text:(b.textContent||'').trim().slice(0,65),disabled:!!b.disabled,ariaDisabled:b.getAttribute('aria-disabled')})).slice(0,35);
function snapshot(phase){return {phase,busy:busy(),selection:(document.body.innerText.match(/\d+\s+cartes? sélectionnées?/i)||[])[0]||null,modal:!!modal(),confirmation:!!confirmationModal(),buttons:buttonState()}}
function confirmationModal(){return [...document.querySelectorAll('.card-frame')].find(f=>visible(f)&&norm(f.textContent).includes('appliquer une etiquette')&&[...f.querySelectorAll('button')].some(b=>visible(b)&&norm(b.textContent)==='termine'))||null}
async function dismissConfirmation(){
 const frame=confirmationModal();if(!frame)return {dismissed:false,newlyTagged:null,alreadyTagged:null};
 const summary=frame.innerText;
 const newMatch=summary.match(/(\d+)\s+cartes?\s+étiquetées?/i);
 const oldMatch=summary.match(/\((\d+)\s+déjà\s+étiquetées?\)/i);
 const newlyTagged=newMatch?Number(newMatch[1]):null;
 const alreadyTagged=oldMatch?Number(oldMatch[1]):null;
 debug('confirmation_detectee',{summary:summary.slice(0,350),newlyTagged,alreadyTagged});
 // La confirmation peut apparaître avant l'actualisation asynchrone de la collection.
 // Observer les mutations et laisser au site le temps de démarrer son actualisation.
 await sleep(220);
 if(busy())debug('actualisation_confirmation_en_cours');
 await idle('actualisation avant Terminé',45000);
 await gate();
 const current=confirmationModal();
 if(!current){debug('confirmation_deja_fermee');return {dismissed:true,newlyTagged,alreadyTagged};}
 const button=[...current.querySelectorAll('button')].find(b=>visible(b)&&norm(b.textContent)==='termine');
 if(!button)throw Error('Bouton Terminé introuvable après actualisation');
 await click(button,'Terminé');
 if(!await wait(()=>!confirmationModal(),8000))throw Error('Fenêtre de confirmation non fermée');
 await idle('après fermeture de confirmation');
 debug('confirmation_fermee',{newlyTagged,alreadyTagged});
 return {dismissed:true,newlyTagged,alreadyTagged};
}

const progress=p=>chrome.runtime.sendMessage({type:'PROGRESS',progress:p}).catch(()=>{});
const norm=s=>(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();
const visible=e=>!!e&&!!(e.offsetWidth||e.offsetHeight||e.getClientRects().length);
const buttons=()=>[...document.querySelectorAll('button')].filter(visible);
const btn=(text,exact=true)=>buttons().find(b=>exact?norm(b.textContent)===norm(text):norm(b.textContent).includes(norm(text)));
async function gate(){if(stopped)throw Error('Arrêt demandé');while(paused){await sleep(250);if(stopped)throw Error('Arrêt demandé')}}
async function wait(fn,ms=12000){const end=Date.now()+ms;while(Date.now()<end){await gate();const x=fn();if(x)return x;await nextDomChange(120)}return null}
const busy=()=>[...document.querySelectorAll('.animate-spin,[class*="animate-spin"],[role="progressbar"],[aria-busy="true"]')].some(visible)||[...document.querySelectorAll('span,div')].some(e=>visible(e)&&e.children.length<3&&/^(chargement|actualisation)(?:\.{1,3}|…)?$/i.test(e.textContent.trim()));
// Mode instantané : MutationObserver, avec délai de stabilisation court et garde-fou.
// Les changements du DOM déclenchent la vérification, sans boucle de polling à 45 ms.
let domVersion=0;
const domObserver=new MutationObserver(()=>{domVersion++});
domObserver.observe(document.documentElement,{subtree:true,childList:true,attributes:true,characterData:true,attributeFilter:['class','disabled','aria-busy','style','hidden']});
function nextDomChange(timeout=250){
 return new Promise(resolve=>{
  let finished=false;
  const observer=new MutationObserver(()=>finish());
  const finish=()=>{if(finished)return;finished=true;observer.disconnect();clearTimeout(timer);resolve()};
  observer.observe(document.documentElement,{subtree:true,childList:true,attributes:true,characterData:true,attributeFilter:['class','disabled','aria-busy','style','hidden']});
  const timer=setTimeout(finish,timeout);
 });
}
async function idle(label,timeout=45000){
 const deadline=Date.now()+timeout;
 let stableSince=0,version=domVersion;
 while(Date.now()<deadline){
  await gate();
  if(busy()){stableSince=0;}
  else {
   if(!stableSince)stableSince=Date.now();
   // Deux frames de stabilité minimum, afin de laisser React mettre à jour l'interface.
   if(Date.now()-stableSince>=80)return;
  }
  await nextDomChange(Math.min(90,Math.max(1,deadline-Date.now())));
  if(version!==domVersion){version=domVersion;if(!busy())stableSince=Date.now()}
 }
 throw Error('Chargement trop long ('+label+'). Vérifie la page puis relance.');
}
async function click(b,label){await idle('avant '+label);await gate();if(!b||!visible(b)||b.disabled||b.getAttribute('aria-disabled')==='true')throw Error('Bouton indisponible : '+label);b.click();await sleep(60);await idle('après '+label)}
function setInput(el,value){const setter=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set;setter.call(el,value);el.dispatchEvent(new Event('input',{bubbles:true}));el.dispatchEvent(new Event('change',{bubbles:true}));}
async function search(word){debug('recherche_debut',{word});await idle('recherche précédente');const inp=await wait(()=>document.querySelector('input[placeholder="Rechercher par titre ou catégorie..."]'));if(!inp)throw Error('Champ de recherche introuvable');setInput(inp,word);await sleep(110);await idle('résultats de « '+word+' »');debug('recherche_terminee',{word,loading:busy()});}
function pageSignature(){return document.body.innerText.slice(-1400)}
function pagination(){const candidates=buttons().filter(b=>!b.disabled&&/suivant|next|page suivante/i.test((b.textContent||'')+' '+(b.getAttribute('aria-label')||'')+' '+(b.title||'')));if(candidates.length)return candidates[0];const svg=buttons().filter(b=>!b.disabled&&b.querySelector('svg polyline[points="9 18 15 12 9 6"],svg.lucide-chevron-right,svg.lucide-arrow-right'));return svg.at(-1)||null}
function noResults(){return /aucune carte|aucun resultat|aucun résultat|0 carte trouvée/i.test(document.body.innerText)}
async function ensureSelect(){await idle('mode sélection');await dismissConfirmation();if(btn('Tout sélectionner (page)')||btn('Désélectionner la page')||btn('Quitter la sélection')){debug('selection_deja_active');return;}const b=btn('Sélectionner');if(!b){debug('selection_introuvable',snapshot('ensureSelect'));throw Error('Bouton Sélectionner introuvable')}await click(b,'Sélectionner');if(!await wait(()=>btn('Tout sélectionner (page)'),5000))throw Error('Mode sélection non activé')}
function modal(){const inp=[...document.querySelectorAll('input[placeholder^="Chercher ou créer une étiquette"]')].find(visible);if(!inp)return null;const frame=inp.closest('.card-frame');if(!frame||!visible(frame)||!norm(frame.textContent).includes('appliquer une etiquette'))return null;return {frame,inp}}
async function applyTag(tag){await dismissConfirmation();await idle('sélection des cartes');let all=btn('Tout sélectionner (page)');if(!all&&btn('Désélectionner la page')){debug('page_deja_selectionnee');}else if(!all||all.disabled){return 0}else{await click(all,'Tout sélectionner (page)');}debug('selection_page',snapshot('apres_tout_selectionner'));const selectionText=[...document.querySelectorAll('div,span')].filter(visible).map(e=>e.textContent.trim()).find(t=>/^\d+\s+cartes? sélectionnées?$/i.test(t));let selectedCount=selectionText?Number(selectionText.match(/^\d+/)[0]):0;const label=await wait(()=>{const b=btn('Étiqueter');return b&&!b.disabled?b:null},6000);if(!label)throw Error('Bouton Étiqueter indisponible après sélection');await click(label,'Étiqueter');const m=await wait(modal,6000);if(!m)throw Error('Fenêtre « Appliquer une étiquette » non ouverte');const modalCount=m.frame.textContent.match(/Sur\s+(\d+)\s+cartes? sélectionnées?/i);if(modalCount)selectedCount=Number(modalCount[1]);setInput(m.inp,tag);await sleep(100);await idle('recherche étiquette');const m2=modal();if(!m2)throw Error('Fenêtre d’étiquetage refermée avant validation');let item=[...m2.frame.querySelectorAll('button')].find(b=>visible(b)&&!b.disabled&&norm(b.textContent)===norm(tag));if(!item)item=[...m2.frame.querySelectorAll('button')].find(b=>visible(b)&&!b.disabled&&/créer|creer/i.test(b.textContent)&&norm(b.textContent).includes(norm(tag)));if(!item)throw Error('Étiquette « '+tag+' » introuvable dans la fenêtre');await click(item,'appliquer « '+tag+' »');debug('etiquette_cliquee',{tag,selectedCount});const confirm=await wait(confirmationModal,12000);if(!confirm){debug('confirmation_absente',snapshot('apres_application'));throw Error('Confirmation Terminé introuvable après application')}const confirmationResult=await dismissConfirmation();if(!await wait(()=>!modal()&&!confirmationModal(),8000))throw Error('La fenêtre d’étiquetage est toujours ouverte : vérifie la validation');await idle('enregistrement étiquette');debug('page_etiquetee',{tag,selectedCount,newlyTagged:confirmationResult.newlyTagged,alreadyTagged:confirmationResult.alreadyTagged});return confirmationResult.newlyTagged??selectedCount}
async function run(categories){
 if(working)return;working=true;stopped=false;paused=false;debug('traitement_demarre',{categories:categories.map(c=>({name:c.name,keywords:c.keywords}))});
 let done=0,applied=0;
 try{
  if(!location.pathname.startsWith('/collection'))throw Error('Ouvre la collection puis relance WikiTagger');
  await idle('collection');
  for(const cat of categories){
   let total=0;
   log('Étiquette '+cat.name+' en cours de traitement');
   for(const word of cat.keywords){
    await gate();await dismissConfirmation();await ensureSelect();if(btn('Désélectionner la page')){await click(btn('Désélectionner la page'),'désélectionner avant recherche');debug('page_deselectionnee_avant_recherche')}await search(word);
    if(noResults()){done++;progress({done,applied,current:cat.name});continue}
    let page=0;
    while(page<200){
     await gate();await dismissConfirmation();await idle('page de résultats');page++;debug('page_debut',{category:cat.name,word,page});await ensureSelect();
     const count=await applyTag(cat.name);
     total+=count;applied+=count;
     progress({done,applied,current:cat.name,page});
     // Un nouveau mot-clé n'est lancé qu'après la dernière page du précédent.
     const next=pagination();
     if(!next){debug('derniere_page',{category:cat.name,word,page});break;}
     const before=pageSignature();
     await click(next,'page suivante');
     await wait(()=>pageSignature()!==before||busy(),6000);
     await idle('page suivante');
     if(pageSignature()===before)throw Error('Pagination non confirmée : traitement suspendu pour éviter les doublons');
    }
    if(page>=200)throw Error('Limite de 200 pages atteinte');
    done++;progress({done,applied,current:cat.name});
   }
   log(total+' cartes trouvées et étiquetées — '+cat.name);
  }
  // Nettoyer l'interface uniquement après la réussite de toutes les catégories.
  await gate();
  await dismissConfirmation();
  await idle('fin du traitement');
  const quitter=btn('Quitter la sélection');
  if(quitter){
    debug('sortie_selection_debut',snapshot('avant_sortie_selection'));
    await click(quitter,'Quitter la sélection');
    const sortieOk=await wait(()=>!btn('Quitter la sélection')&&!!btn('Sélectionner'),8000);
    if(!sortieOk)throw Error('Impossible de confirmer la sortie du mode sélection');
    await idle('après sortie de sélection');
    debug('sortie_selection_confirmee');
  }else{
    debug('sortie_selection_inutile',snapshot('fin_traitement'));
  }
  debug('traitement_termine',{done,applied});chrome.runtime.sendMessage({type:'DONE'}).catch(()=>{});
 }catch(e){debug('erreur',{message:e.message,stack:e.stack,snapshot:snapshot('exception')});log('Erreur : '+e.message);chrome.runtime.sendMessage({type:'DONE',error:e.message}).catch(()=>{})}
 finally{working=false}
}
async function labels(){
  if(!location.pathname.startsWith('/collection'))throw Error('COLLECTION_REQUIRED');
  await idle('listing');
  let el=buttons().find(b=>norm(b.textContent).includes('toutes les etiquettes'));
  if(!el){const candidate=[...document.querySelectorAll('span')].find(e=>visible(e)&&norm(e.textContent)==='toutes les etiquettes');el=candidate?.closest('button,[role="combobox"],[role="button"]')||candidate?.parentElement?.parentElement;}
  if(!el||!visible(el))throw Error('Menu Toutes les étiquettes introuvable sur la page Collection');
  await click(el,'ouvrir liste des étiquettes');
  try {
    const found=await wait(()=>[...document.querySelectorAll('span')].some(e=>visible(e)&&e.textContent.trim().startsWith('#')),6000);
    if(!found)throw Error('Liste des étiquettes vide ou non affichée');
    const spans=[...document.querySelectorAll('span')].filter(visible).map(e=>e.textContent.trim()).filter(x=>x.startsWith('#')&&x.length>1);
    const clean=x=>x.replace(/^#\s*/,'').replace(/\s*\(\d+\)\s*$/,'').trim();
    return [...new Set(spans.map(clean).filter(Boolean))];
  } finally {
    // Toujours replier le menu, y compris si le listing échoue.
    if(visible(el) && [...document.querySelectorAll('span')].some(e=>visible(e)&&e.textContent.trim().startsWith('#'))) {
      el.click();
      debug('liste_etiquettes_repliee',{url:location.href});
    }
  }
}
chrome.runtime.onMessage.addListener((m,s,reply)=>{if(m.type==='START'){run(m.categories);reply({ok:true})}else if(m.type==='PAUSE'){paused=true;reply({ok:true})}else if(m.type==='RESUME'){paused=false;reply({ok:true})}else if(m.type==='STOP'){stopped=true;paused=false;reply({ok:true})}else if(m.type==='LABELS'){labels().then(x=>reply({labels:x,error:x?null:'Menu Toutes les étiquettes introuvable'})).catch(e=>reply({error:e.message}));return true}else if(m.type==='PING'){reply({ok:true,working})}return false});
})();


const host=document.createElement('div');host.id='wikitagger-tampermonkey-root';host.style.cssText='position:fixed;z-index:2147483647;right:0;bottom:0';
const ui=host.attachShadow({mode:'open'});
const style=document.createElement('style');style.textContent='*{box-sizing:border-box}body{margin:0;width:390px;background:#101614;color:#e9f6f0;font:13px system-ui,Arial}main{padding:16px}h1{margin:0;font-size:22px}small,.muted{color:#a2b8af}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}.dot{display:inline-block;width:10px;height:10px;border-radius:50%;background:#777;margin-right:5px}.panel{background:#1b2521;border:1px solid #34453d;border-radius:12px;padding:12px;margin-bottom:12px}h2{font-size:14px;margin:0 0 10px}button{cursor:pointer;background:#273a31;color:#f4fff8;border:1px solid #476454;border-radius:8px;padding:8px 10px;font-weight:600}button.primary{background:#32d6a0;color:#082319;border-color:#32d6a0}button.danger{background:#4a2727}button:disabled{opacity:.4}input,textarea{width:100%;background:#111a16;color:white;border:1px solid #506458;border-radius:7px;padding:9px;margin:4px 0 9px;font:inherit}textarea{min-height:65px;resize:vertical}.row{display:flex;gap:7px;align-items:center}.row>*{flex:1}.row button{flex:0 0 auto}.category{display:flex;gap:8px;align-items:center;border-bottom:1px solid #33453b;padding:8px 0}.category input{width:auto;margin:0}.category .name{flex:1}.category small{display:block}.scroll{max-height:160px;overflow:auto}#log{font:11px/1.5 ui-monospace,monospace;max-height:130px;overflow:auto;white-space:pre-wrap;color:#b9e4d2}.hidden{display:none}#status{font-weight:700;color:#8beac5}#existing{max-height:160px;overflow:auto;line-height:1.9}.bar{height:6px;background:#39483f;border-radius:6px;overflow:hidden;margin-top:9px}.bar>div{height:100%;width:0;background:#32d6a0}.brand{display:flex;align-items:center;gap:10px}.brand-logo{width:56px;height:56px;object-fit:contain;flex-shrink:0}.top{gap:10px}.top>span{font-size:11px;text-align:right;max-width:105px}'+'\n:host{all:initial;font:13px system-ui,Arial;color:#e9f6f0}#wt-panel{width:390px;max-width:calc(100vw - 18px);height:min(88vh,850px);overflow:auto;background:#101614;border:1px solid #476454;border-radius:14px;box-shadow:0 10px 40px #0009;color:#e9f6f0}#wt-panel *{box-sizing:border-box}#wt-panel main{padding:16px}#wt-panel input[type=checkbox]{width:auto}#wt-toggle{position:fixed;right:16px;bottom:16px;z-index:1;border-radius:30px;background:#32d6a0;color:#082319;padding:12px 16px;font-weight:800;box-shadow:0 6px 20px #0007;cursor:pointer;border:1px solid #32d6a0}#wt-close{position:absolute;right:10px;top:8px;background:#273a31;border:1px solid #476454;border-radius:8px;color:white;padding:5px 9px;cursor:pointer}#wt-wrapper{position:fixed;right:16px;bottom:70px;z-index:2;display:none}#wt-wrapper.open{display:block}#wt-panel .top{padding-right:26px}#wt-panel .category .name{min-width:0;overflow-wrap:anywhere}#wt-panel button{font-size:12px}\n';ui.appendChild(style);
const wrapper=document.createElement('div');wrapper.id='wt-wrapper';
wrapper.innerHTML='<div id="wt-panel" style="position:relative"><button id="wt-close" type="button" title="Fermer">×</button>'+'<main><div class="top"><div><div class="brand"><img src="data:image/png;base64," alt="Logo WikiTagger" class="brand-logo"><div><h1>WikiTagger</h1><small>Classement de ta collection</small></div></div></div><span><i class="dot" id="dot"></i><span id="site">Recherche...</span></span></div><section class="panel"><h2>Mes catégories</h2><p class="muted">Les étiquettes importées apparaissent ici, décochées par défaut. Coche celles à traiter.</p><div id="categories" class="scroll"></div><button id="new">+ Ajouter une catégorie</button><div id="editor" class="hidden"><input id="name" maxlength="48" placeholder="Nom exact de l\'étiquette WikiMasters"><textarea id="keywords" placeholder="Exemple : mot1 , mot2"></textarea><div class="row"><button class="primary" id="save">Enregistrer</button><button id="cancel">Annuler</button></div></div></section><section class="panel"><h2>Importer les étiquettes existantes</h2><button id="list">Listing des étiquettes</button><p class="muted" id="listinfo">Lit la liste depuis ta collection.</p></section><section class="panel"><h2>Automatisation</h2><div class="row"><button class="primary" id="start">▶ Démarrer</button><button id="pause">⏸ Pause</button><button class="danger" id="stop">■ Arrêter</button></div><p id="status">Prêt</p><small id="progress">Sélectionne une ou plusieurs catégories.</small><div class="bar"><div id="fill"></div></div></section><section class="panel"><h2>Activité en direct</h2><div id="log">Aucune action pour le moment.</div><div class="row" style="margin-top:10px"><button id="exportdiag">Exporter les logs JSON</button><button id="cleardiag">Effacer les logs</button></div><small class="muted">Les diagnostics sont conservés localement. Vérifie le fichier avant de le partager.</small></section><small>Fonctionne sur l\'onglet WikiMasters ouvert. Extension indépendante non destinée à la triche sur le jeu Wiki-Master.com. Développé par HYZO.</small></main>'+'</div>';
ui.appendChild(wrapper);
const toggle=document.createElement('button');toggle.id='wt-toggle';toggle.textContent='🏷️ WikiTagger';ui.appendChild(toggle);
toggle.addEventListener('click',()=>wrapper.classList.toggle('open'));
wrapper.querySelector('#wt-close').addEventListener('click',()=>wrapper.classList.remove('open'));
document.documentElement.appendChild(host);

(function(){
const $=id=>ui.getElementById(id);let categories=[],edit=-1,tabId=null,working=false,paused=false;
const norm=s=>s.trim();const key=s=>norm(s).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();const save=async()=>chrome.storage.local.set({categories});
const message=async m=>{
  if(tabId===null)throw Error('Ouvre WikiMasters dans un onglet');
  try { return await chrome.tabs.sendMessage(tabId,m); }
  catch(e) {
    // L'onglet était peut-être ouvert avant l'installation ou la mise à jour.
    if(!/Receiving end does not exist|Could not establish connection/i.test(String(e))) throw e;
    await chrome.scripting.executeScript({target:{tabId},files:['content.js']});
    return await chrome.tabs.sendMessage(tabId,m);
  }
};
const siteUrl=u=>/^https:\/\/(www\.)?wiki-masters\.com(?:\/|$)/i.test(u||'');
async function locate(){const tabs=await chrome.tabs.query({active:true,currentWindow:true});const t=tabs[0];tabId=t&&siteUrl(t.url)?t.id:null;updateSite();return t}
function updateSite(){const on=tabId!==null;$('dot').style.background=on?'#39aaff':'#f05252';$('site').textContent=on?'Site détecté':'Site non détecté'}
async function ensureCollection(){await locate();if(tabId===null){$('listinfo').textContent='Ouvre WikiMasters dans cet onglet, puis relance le listing.';return false}const t=await chrome.tabs.get(tabId);if(new URL(t.url).pathname.startsWith('/collection'))return true;$('listinfo').textContent='Ouverture de la collection…';await chrome.tabs.update(tabId,{url:'https://www.wiki-masters.com/collection'});for(let i=0;i<40;i++){await new Promise(r=>setTimeout(r,350));const x=await chrome.tabs.get(tabId);if(x.status==='complete'&&new URL(x.url).pathname.startsWith('/collection')){await new Promise(r=>setTimeout(r,600));return true}}throw Error('La collection ne s’est pas chargée.');}
function render(){const el=$('categories');el.replaceChildren();if(!categories.length)el.textContent='Aucune catégorie pour le moment.';categories.forEach((c,i)=>{const row=document.createElement('div');row.className='category';const ck=document.createElement('input');ck.type='checkbox';ck.checked=c.selected!==false;ck.onchange=()=>{c.selected=ck.checked;save()};const info=document.createElement('div');info.className='name';const b=document.createElement('b');b.textContent=c.name;const sm=document.createElement('small');sm.textContent=c.keywords.length?c.keywords.join(' , '):'Mots-clés à renseigner (✎)';info.append(b,sm);const ed=document.createElement('button');ed.textContent='✎';ed.title='Modifier';ed.onclick=()=>editor(i);const del=document.createElement('button');del.textContent='×';del.title='Supprimer';del.onclick=async()=>{if(confirm('Supprimer cette catégorie ?')){categories.splice(i,1);await save();render()}};row.append(ck,info,ed,del);el.append(row)})}
function editor(i){edit=i;$('editor').classList.remove('hidden');$('name').value=i<0?'':categories[i].name;$('keywords').value=i<0?'':categories[i].keywords.join(' , ')}
$('new').onclick=()=>editor(-1);$('cancel').onclick=()=>$('editor').classList.add('hidden');$('save').onclick=async()=>{const name=norm($('name').value);const keywords=[...new Set($('keywords').value.split(',').map(norm).filter(Boolean))];if(!name||!keywords.length)return alert('Indique un nom et au moins un mot-clé.');const c={name,keywords,selected:edit<0?true:categories[edit].selected!==false};if(categories.some((v,j)=>j!==edit&&key(v.name)===key(name)))return alert('Cette catégorie existe déjà.');if(edit<0)categories.push(c);else categories[edit]={...categories[edit],...c};await save();$('editor').classList.add('hidden');render()};
$('list').onclick=async()=>{try{
  $('listinfo').textContent='Lecture des étiquettes en cours…';
  if(!await ensureCollection())return;const r=await message({type:'LABELS'});if(r.error)throw Error(r.error);
  const labels=[...new Set((r.labels||[]).map(x=>norm(x.replace(/\s*\(\d+\)\s*$/,''))).filter(Boolean))];
  let added=0;
  for(const name of labels){
    if(!categories.some(c=>key(c.name)===key(name))){
      categories.push({name,keywords:[],selected:false});added++;
    }
  }
  await save();render();
  $('listinfo').textContent=labels.length+' étiquette(s) trouvée(s), '+added+' ajoutée(s) dans Mes catégories. Coche celles à traiter et renseigne leurs mots-clés avec ✎.';
}catch(e){$('listinfo').textContent='Erreur : '+e.message}};
$('start').onclick=async()=>{try{await locate();const selected=categories.filter(c=>c.selected!==false);if(!selected.length)throw Error('Coche au moins une catégorie');const missing=selected.filter(c=>!c.keywords?.length);if(missing.length)throw Error('Ajoute des mots-clés à : '+missing.map(c=>c.name).join(', '));const t=await chrome.tabs.get(tabId);if(!new URL(t.url).pathname.startsWith('/collection'))throw Error('Ouvre la page Collection avant de démarrer.');await message({type:'START',categories:selected});working=true;paused=false;await chrome.storage.local.set({running:true,paused:false});updateState()}catch(e){alert(e.message)}};
$('pause').onclick=async()=>{try{if(!working)return;paused=!paused;await message({type:paused?'PAUSE':'RESUME'});await chrome.storage.local.set({paused});updateState()}catch(e){alert(e.message)}};
$('stop').onclick=async()=>{try{await message({type:'STOP'});working=false;paused=false;await chrome.storage.local.set({running:false,paused:false});updateState()}catch(e){alert(e.message)}};
function updateState(){$('status').textContent=working?(paused?'En pause':'Traitement en cours'):'Prêt';$('dot').style.background=tabId===null?'#f05252':working?'#39d795':'#39aaff';$('site').textContent=tabId===null?'Site non détecté':working?'WikiTagger actif':'Site détecté';$('pause').textContent=paused?'▶ Reprendre':'⏸ Pause'}
async function refresh(){const v=await chrome.storage.local.get(['logs','progress','running','paused']);working=!!v.running;paused=!!v.paused;updateState();$('log').textContent=(v.logs||[]).filter(x=>/^Étiquette .+ en cours de traitement$|^\d+ cartes trouvées et étiquetées/.test(x.text)).slice(0,12).map(x=>x.time+' — '+x.text).join('\n')||'En attente du traitement.';const p=v.progress||{};$('progress').textContent=p.current?`${p.current} • ${p.applied||0} carte(s) étiquetée(s) • ${p.done||0} recherche(s) terminée(s)`:'Sélectionne une ou plusieurs catégories.';const total=categories.filter(c=>c.selected!==false).reduce((n,c)=>n+c.keywords.length,0);$('fill').style.width=total?Math.min(100,100*(p.done||0)/total)+'%':'0%'}
(async()=>{categories=(await chrome.storage.local.get('categories')).categories||[];render();await locate();await refresh();setInterval(async()=>{await locate();await refresh()},1000)})();

$('exportdiag').onclick=async()=>{
 const data=await chrome.storage.local.get(['diagnostics','logs','progress']);
 const payload={application:'WikiTagger',version:'1.9.0',exportedAt:new Date().toISOString(),userAgent:navigator.userAgent,diagnostics:data.diagnostics||[],activity:data.logs||[],progress:data.progress||{}};
 const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json'});
 const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='WikiTagger_diagnostics_'+new Date().toISOString().replace(/[:.]/g,'-')+'.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);
};
$('cleardiag').onclick=async()=>{if(confirm('Effacer tous les diagnostics enregistrés ?'))await chrome.storage.local.set({diagnostics:[]})};

})();
})();
